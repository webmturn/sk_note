    <color name="on_primary">#FF003258</color>
    <color name="primary_container">#FF004A77</color>
    <color name="on_primary_container">#FFD1E4FF</color>
    <color name="secondary">#FFB0BEC5</color>
    <color name="on_secondary">#FF1B3240</color>
    <color name="secondary_container">#FF324957</color>
    <color name="on_secondary_container">#FFCFE5ED</color>

    <!-- 夜间 tertiary：沿用同一规律（角色取 200 调、容器取 900 调、
         on_*_container 与浅色容器同值） -->
    <color name="tertiary">#FF80CBC4</color>
    <color name="on_tertiary">#FF003731</color>
    <color name="tertiary_container">#FF004D40</color>
    <color name="on_tertiary_container">#FFB2DFDB</color>

    <!-- Snackbar（提示条）配色，与浅色成对声明。
         **这里刻意偏离 M3 的「反色」语义**：M3 基线在深色主题里把提示条做成
         浅底（inverseSurface = neutral90 #E6E0E9），本项目改为深色浮起层，
         避免深色界面里每次提示都跳出一条亮白条。
         底取 M3 的 surfaceContainerHigh（深色 #2B2930）—— 比页面 #141218 与卡片
         #1E1E2E 都亮一档，提示条因此仍「浮」得起来；文字与动作按钮沿用浅色那套
         （两者都是画在深色底上，不需要区分昼夜）。 -->
    <color name="snackbar_container">#FF2B2930</color>

    <color name="icon_bg_orange">#66795548</color>
    <color name="icon_bg_green">#66388E3C</color>
    <color name="icon_bg_purple">#667B1FA2</color>
    <color name="icon_bg_teal">#6600796B</color>
    <color name="icon_bg_blue">#661565C0</color>
    <color name="icon_bg_red">#66C62828</color>
    <color name="icon_bg_indigo">#663F51B5</color>
    <color name="text_danger">#FFEF5350</color>
    <color name="banner_text">#FFFFFFFF</color>
    <color name="banner_text_secondary">#B3FFFFFF</color>
    <!-- 夜间启动页底色与浅色保持一致（品牌蓝）。
         曾试过改成项目自己的 surface_card(#FF1E1E2E) 以在深色下减少亮蓝，
         但真机实测发现：系统「启动窗口」（应用进程起来前由系统绘制的那一屏）
         只读【浅色】的 @color/splash_background，无视夜间配置——把浅色值临时
         改成洋红后启动窗口随之变洋红，而夜间值改成 #1E1E2E 后启动窗口仍是蓝色。
         因此单独改夜间值只会造成「蓝色启动窗口 → 深色启动页」的闪变。
         除非把浅色值也改深（会失去浅色模式的品牌色），否则无法消除该闪变，
         故维持两套一致。 -->
    <color name="splash_background">#FF1976D2</color>

    <!-- 外壳色，取值钉在 M3 的夜间 colorSurface 上（m3_sys_color_dark_surface
         = m3_ref_palette_neutral6 = #141218），理由与同步要求见 values/colors.xml。
         原值是项目自建的 #1E1E2E（偏蓝一档），它正是每页顶部那道 33dp 色带接缝
         的来源；真机实测内容是 #141218，故对齐到同一个值。
         上面 splash 注释里提到的 surface_card 旧值 #FF1E1E2E，指的就是这个原值。 -->
    <color name="surface_card">#FF141218</color>
    <color name="surface_elevated">#FF252536</color>
    <color name="detail_section_bg">#FF1A1A2A</color>
    <color name="theme_preview_light_bg">#FF6B5C2E</color>
    <color name="theme_preview_light_icon">#FFFFE082</color>
    <color name="theme_preview_dark_bg">#FF263238</color>
    <color name="theme_preview_dark_icon">#FFD0D7DE</color>
    <color name="code_bg">#FF161622</color>
    <color name="accent_strip_alpha">#40FFFFFF</color>

    <color name="skeleton_base">#FF202028</color>
</resources>
