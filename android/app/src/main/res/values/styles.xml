<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      图标底板：MaterialCardView 内嵌一个 ImageView 的「图标 + 底色」组合。
      用于列表行的行首图标。

      尺寸 40dp + 子 ImageView padding 8dp = 24dp 图标字形。
      全项目原有三种同类底板并存（42dp/12dp/pad9、40dp/10dp/pad8、
      38dp/11dp/pad8），现统一到这一种：
        - 原 42dp 那批字形本来就是 24dp，改成 40dp + pad8 后字形不变，
          仅底板小 2dp；
        - 原 38dp 那批字形会由 22dp 变为 24dp。
      另有约 20 处 MaterialCardView+单 ImageView 属于别的角色（头像、
      圆形统计块、品牌 logo、卡片内装饰图标等），不并入本样式。
      用法：
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SkNote.IconTile"
            app:cardBackgroundColor="@color/icon_bg_green"
            android:layout_marginEnd="16dp">
            <ImageView ... android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>
    -->
    <style name="Widget.SkNote.IconTile" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- 筛选 Tab：统一指示条与文字配色，供 XML 声明的 TabLayout 复用。
         父级与 M3 主题的 tabStyle 默认值一致，故显式引用不会绕过主题。 -->
    <style name="Widget.SkNote.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
