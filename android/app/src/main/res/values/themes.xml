<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      主题分「Base + 薄包装」两层，是为了让 windowLightNavigationBar（API 27 起）能
      放进 values-v27/ 而不丢掉其余条目。

      原因：同名 style 放在不同配置目录时是互相【替代】的资源变体，Android 按配置整体
      选取其中一个，不会把 values/ 与 values-v27/ 的条目合并。此前把 Theme.SkNote 同时
      定义在 values/ 与 values-v27/，导致 API 27+ 设备上整个主题只剩 windowLightNavigationBar
      一项，statusBarColor、windowLightStatusBar、navigationBarColor 与 8 个
      colorPrimary*/colorSecondary* 全部失效——实测状态栏被 M3 基线 colorPrimary
      (#D0BCFF) 接管，项目配色在所有 API 27+ 设备上均未生效。

      所以：与 API 级别无关的条目一律放进 .Base（仅在 values/ 与 values-night/ 之间
      按昼夜切换），Theme.SkNote 本身只负责叠加 API 相关项。
    -->
    <style name="Theme.SkNote.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>
        <!-- Snackbar（提示条）用的三个角色。不声明就会落回 M3 基线：浅色下得到
             基线灰底 + 基线【淡紫】动作文字；夜间会拿到基线浅底（亮白条）。
             注意 attr 名是「角色名 + Inverse」（colorSurfaceInverse 而非
             colorInverseSurface）—— 以 material-1.11.0.aar 的 public.txt 为准。
             本项目给它们的取值并不「反色」，理由见 values/colors.xml。 -->
        <item name="colorSurfaceInverse">@color/snackbar_container</item>
        <item name="colorOnSurfaceInverse">@color/snackbar_on_container</item>
        <item name="colorPrimaryInverse">@color/snackbar_action</item>
        <!-- 系统栏（状态栏 / 导航栏）与底部导航栏统一用项目的 surface_card。
             本次修的是「色带接缝」：surface_card 的取值原先与内容所用的 M3 colorSurface
             不同源（浅色 #FFFFFF vs #FEF7FF、夜间 #1E1E2E vs #141218），于是每一页顶部
             33dp 都是「状态栏一个色、其下内容另一个色」的横向接缝（真机实测夜间
             #1E1E2E 与 #141218）。这里不改结构，只把 surface_card 的取值对齐到
             M3 colorSurface（见 colors.xml），三处角色因此天然同色。
             导航栏区域在手势导航下透出的本来就是窗口背景（= colorSurface），对齐后
             三键导航与手势导航表现一致。 -->
        <item name="android:statusBarColor">@color/surface_card</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
    </style>

    <style name="Theme.SkNote" parent="Theme.SkNote.Base" />

    <style name="Theme.SkNote.Launch.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.SkNote.Launch" parent="Theme.SkNote.Launch.Base" />

    <style name="Theme.SkNote.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.SkNote.Launch</item>
    </style>

    <!--
      底部导航栏。尺寸是「64dp 紧凑栏」，三个值必须成组看：
        android:minHeight = bottom_nav_height(64dp)
        itemPaddingTop/Bottom = 8dp
        内容 = 8 + 指示条 32 + 标签 16 + 8 = 64dp
      为什么必须写 android:minHeight：Material 库把
      m3_comp_navigation_bar_container_height(80dp) 用作父样式的 android:minHeight，
      它是下限而不是建议值 —— 只把 layout_height 写成 64dp 会被它顶回 80dp。
      （两天前那次「64dp 失败」就是把内边距压到 2dp 硬塞，而不是覆盖 minHeight。）
      配色走项目自己的定义：底栏与状态栏同色（surface_card），选中图标用 colorPrimary。
      第十一批把这一行从 M3 默认的 surfaceContainer(#211F26) 改到 surface_card，是刻意的
      （「底栏与状态栏一致」）；本次修色带接缝改的是 surface_card 的取值而不是这里，
      所以那层关系保持成立，两个模式也一致。
    -->
    <style name="Widget.SkNote.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">@dimen/bottom_nav_height</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
        <item name="backgroundTint">@color/surface_card</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.SkNote.BottomNavigation.ActiveIndicator</item>
        <item name="itemIconTint">@color/bottom_nav_icon_color</item>
        <item name="itemTextColor">@color/bottom_nav_icon_color</item>
        <item name="labelVisibilityMode">selected</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.SkNote.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SkNote.BottomNav.Indicator</item>
    </style>

    <style name="ShapeAppearance.SkNote.BottomNav.Indicator" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">16dp</item>
    </style>
</resources>
