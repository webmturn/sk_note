    <color name="tertiary_container">#FFB2DFDB</color>
    <color name="on_tertiary_container">#FF00201A</color>

    <!-- Snackbar（提示条）的三个颜色。它们是接到 M3 的
         colorSurfaceInverse / colorOnSurfaceInverse / colorPrimaryInverse 上的
         （M3 的 Snackbar 就是这么接线的），但**本项目刻意不让它「反色」**：
         夜间也保持深色底，否则深色界面里每次提示都跳出一条亮白条，很刺眼。
         因此这里的命名按用途（snackbar_*）而不是按 M3 的角色语义，
         两个模式下的取值见 values-night/colors.xml。 -->
    <color name="snackbar_container">#FF263238</color>
    <color name="snackbar_on_container">#FFECEFF1</color>
