<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="primary">#FF1976D2</color>
    <color name="on_primary">#FFFFFFFF</color>
    <color name="primary_container">#FFD1E4FF</color>
    <color name="on_primary_container">#FF001D36</color>
    <color name="secondary">#FF546E7A</color>
    <color name="on_secondary">#FFFFFFFF</color>
    <color name="secondary_container">#FFCFE5ED</color>
    <color name="on_secondary_container">#FF0B1D29</color>

    <!-- tertiary 取 Material Teal，与主色 Material Blue / Blue Grey 同族。
         项目此前只定义 primary 与 secondary，导致 20 处 ?attr/colorTertiary*
         引用落回 M3 基线的酒红（#633B48），与蓝色系冲突。 -->
    <color name="tertiary">#FF00796B</color>
    <color name="on_tertiary">#FFFFFFFF</color>
    <color name="tertiary_container">#FFB2DFDB</color>
    <color name="on_tertiary_container">#FF00201A</color>

    <!-- Snackbar（提示条）的三个颜色。它们是接到 M3 的
         colorSurfaceInverse / colorOnSurfaceInverse / colorPrimaryInverse 上的
         （M3 的 Snackbar 就是这么接线的），但**本项目刻意不让它「反色」**：
         夜间也保持深色底，否则深色界面里每次提示都跳出一条亮白条，很刺眼。
         因此这里的命名按用途（snackbar_*）而不是按 M3 的角色语义，
         两个模式下的取值见 values-night/colors.xml。 -->
    <color name="snackbar_container">#FF263238</color>
    <color name="snackbar_on_container">#FFECEFF1</color>
    <color name="snackbar_action">#FF90CAF9</color>

    <color name="icon_bg_orange">#FFE0B2</color>
    <color name="icon_bg_green">#C8E6C9</color>
    <color name="icon_bg_purple">#E1BEE7</color>
    <color name="icon_bg_teal">#B2DFDB</color>
    <color name="icon_bg_blue">#BBDEFB</color>
    <color name="icon_bg_red">#FFCDD2</color>
    <color name="icon_bg_indigo">#C5CAE9</color>
    <color name="text_danger">#D32F2F</color>
    <color name="banner_text">#FFFFFFFF</color>
    <color name="banner_text_secondary">#B3FFFFFF</color>
    <color name="splash_background">#FF1976D2</color>

    <!-- 外壳（状态栏 / 导航栏 / 底部导航栏）统一用这个色。
         取值刻意钉在 M3 的 colorSurface 上（浅色 = m3_sys_color_light_surface
         = m3_ref_palette_neutral98 = #FEF7FF；夜间见 values-night），
         为的是让「外壳」和「内容」落在同一个平面上 —— 此前浅色是 #FFFFFF、
         夜间是 #1E1E2E，与内容的 colorSurface 不同源，于是每页顶部 33dp 都有一道
         横向色带接缝。之所以不直接写 ?attr/colorSurface，是为了保住项目自己对外壳
         配色的控制点（第十一批「底栏与状态栏同色」就是在这上面做的）。
         代价：material 升级若改了 colorSurface，这里要跟着同步（同
         dimens.xml 里 bottom_nav_height 与 bottom_nav_content_inset 的关系）。 -->
    <color name="surface_card">#FFFEF7FF</color>
    <color name="surface_elevated">#FFF5F5F5</color>
    <color name="detail_section_bg">#FFF8F9FA</color>
    <color name="theme_preview_light_bg">#FFF8E1</color>
    <color name="theme_preview_light_icon">#FFA000</color>
    <color name="theme_preview_dark_bg">#FF37474F</color>
    <color name="theme_preview_dark_icon">#FFB0BEC5</color>
    <color name="code_bg">#FFF1F3F4</color>
    <color name="accent_strip_alpha">#30000000</color>

    <color name="skeleton_base">#FFE8ECEF</color>
</resources>
