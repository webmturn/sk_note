<?xml version="1.0" encoding="utf-8"?>
<!--
  首页加载占位。骨架只覆盖「分类 + 最新文章」两块动态内容——顶部问候、
  搜索框、快捷卡片都是静态的，加载期间照常显示，不需要占位。
  占位块尺寸与间距对齐 fragment_home.xml 中对应的真实结构，避免加载完成时跳动。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:visibility="gone">

    <!-- 「分类」标题占位 -->
    <View
        android:layout_width="56dp"
        android:layout_height="20dp"
        android:background="@drawable/skeleton_block" />

    <!-- 分类卡片占位：图标块 + 两行文字 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/skeleton_block_lg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <View
                    android:layout_width="80dp"
                    android:layout_height="14dp"
                    android:background="@drawable/skeleton_block" />

                <View
                    android:layout_width="150dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/skeleton_block" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 「最新文章」标题行占位 -->
    <View
        android:layout_width="88dp"
        android:layout_height="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/skeleton_block" />

    <!-- 文章卡片占位：复用列表页同一套骨架卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <include
            layout="@layout/layout_skeleton_card_article"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            layout="@layout/layout_skeleton_card_article"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            layout="@layout/layout_skeleton_card_article"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
